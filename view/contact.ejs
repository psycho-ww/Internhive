<%- include('partials/header') %>
<style>
    /* Premium Glamorous Purple Palette Upgrades */
    :root {
        --primary-gradient: linear-gradient(135deg, #00c6ff, #99c0ef, #b16cf2);/* Radiant Purple to Amethyst */
        --sparkle-gradient:   linear-gradient(135deg, #00c6ff, #7bb4f9, #9333ea);/* Deep Luxury Violet */
        --dark-text: #2d3748;
        --light-text: #666666;
        --border-color: #f3e8ff;
        --shadow-glow: 0 20px 40px rgba(107, 70, 193, 0.12), 0 5px 15px rgba(0, 0, 0, 0.04);
        --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        --bg-white: #ffffff;
    }
    
    body {
        overflow-x: hidden; /* Safeguards against viewport horizontal overflow on mobile screens */
    }

    /* Long & Thin Side-by-Side Flexbox Layout Wrapper */
    .contact-layout-wrapper {
        display: flex;
        gap: 24px;
        max-width: 900px; /* Reduced width for a sleeker, thinner profile */
        margin: 40px auto;
        padding: 0 15px;
        align-items: stretch;
        box-sizing: border-box;
        width: 100%;
    }
    /* Long & Thin Panels Configuration */
    .left-panel {
        flex: 1;
        background: var(--sparkle-gradient);
        color: #fff;
        padding: clamp(25px, 4vw, 45px) clamp(20px, 3vw, 35px); /* Fluid responsive padding */
        border-radius: 24px;
        box-shadow: var(--shadow-glow);
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
        min-width: 0;
    }
    .right-panel {
        flex: 1.1;
        background: #fff;
        padding: clamp(25px, 4vw, 45px) clamp(20px, 3vw, 35px); /* Fluid responsive padding */
        border-radius: 24px;
        box-shadow: var(--shadow-glow);
        border: 1px solid rgba(107, 70, 193, 0.08);
        box-sizing: border-box;
        min-width: 0;
    }
    /* Left Panel Inner Elements Styling */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        border-radius: 40px;
        background: rgba(255, 255, 255, 0.12);
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.8px;
        margin-bottom: 25px;
        align-self: flex-start;
        color: #f3e8ff;
    }
    .left-panel h3 {
        font-size: clamp(1.3rem, 2.5vw, 26px); /* Fluid text scaling across screen sizes */
        line-height: 1.25;
        margin-bottom: 15px;
        font-weight: 700;
        background: linear-gradient(to right, #ffffff, #f3e8ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        word-break: break-word;
    }
    .left-panel p {
        font-size: 14px;
        line-height: 1.6;
        color: #e9d5ff;
        margin-bottom: 35px;
    }
    .info-box {
        display: flex;
        gap: 15px;
        align-items: center;
        background: rgba(255, 255, 255, 0.06);
        padding: 14px 18px;
        border-radius: 14px;
        margin-bottom: 14px;
        width: 100%;
        box-sizing: border-box;
        border: 1px solid rgba(255, 255, 255, 0.04);
        transition: var(--transition-smooth);
    }
    .info-box:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(3px);
    }
    .info-box .icon {
        width: 38px;
        height: 38px;
        background: rgba(255, 255, 255, 0.15);
        color: var(--bg-white);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }
    .info-box div {
        min-width: 0;
        word-break: break-word;
    }
    .info-box span {
        font-size: 10px;
        font-weight: 700;
        opacity: .7;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #121112;
        display: block;
    }
    .info-box h4 {
        margin: 2px 0 0 0;
        font-size: 14px;
        font-weight: 600;
        color: #0d0b0b;
    }
    /* Right Panel - Purple Theme Variants */
    .contact-title {
        font-size: clamp(1.2rem, 2vw, 22px);
        font-weight: 700;
        color: #6b46c1; /* Deep Purple */
        display: flex; 
        align-items: center; 
        gap: 10px;
        margin: 0 0 10px 0;
        word-break: break-word;
    }
    .contact-desc {
        color: var(--light-text); 
        font-size: 13px; 
        margin-bottom: 20px;
        line-height: 1.5;
    }
    .divider {
        border: 0;
        height: 1px;
        background: linear-gradient(to right, rgba(107, 70, 193, 0.2), rgba(107, 70, 193, 0.02));
        margin-bottom: 20px;
    }
    
    /* Form Labels & Account Details Box */
    .form-label {
        font-weight: 600; 
        color: var(--dark-text);
        font-size: 13px;
        display: block;
        margin-bottom: 6px;
    }
    .form-label-spacing {
        font-weight: 600; 
        color: var(--dark-text);
        font-size: 13px;
        margin-top: 18px; 
        display: block;
        margin-bottom: 6px;
    }
    .account-details-box {
        background: #faf8ff; /* Soft tint of purple background */
        padding: 14px 18px; 
        border-radius: 10px; 
        margin: 8px 0; 
        font-size: 14px; 
        border-left: 4px solid #6b46c1;
        box-shadow: inset 0 1px 2px rgba(107,70,193,0.02);
        line-height: 1.6;
        color: #4a5568;
        word-break: break-word;
    }
    
    /* Inputs Configuration */
    .message-textarea {
        resize: vertical;
        width: 100%; 
        box-sizing: border-box; 
        padding: 14px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        font-size: 14px;
        outline: none;
        background-color: #fafbfe;
        transition: var(--transition-smooth);
    }
    .message-textarea:focus {
        border-color: #a855f7;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.12);
    }
    
    /* Elegant Buttons Group */
    .btn-group {
        margin-top: 20px; 
        display: flex; 
        gap: 12px;
        flex-wrap: wrap; /* Ensures buttons wrap cleanly on narrow phone screens */
    }
    .btn-submit {
        flex: 2; 
        min-width: 130px;
        font-weight: bold;
        background: var(--primary-gradient);
        color: #ffffff;
        border: none;
        padding: 12px 20px;
        border-radius: 10px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(107, 70, 193, 0.2);
        transition: var(--transition-smooth);
    }
    .btn-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(107, 70, 193, 0.35);
        opacity: 0.95;
    }
    .btn-cancel {
        flex: 1;
        min-width: 90px;
        background: #f3e8ff; 
        color: #6b46c1; 
        text-align: center;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: bold;
        transition: var(--transition-smooth);
        box-sizing: border-box;
    }
    .btn-cancel:hover {
        background: #e9d5ff;
        color: #5b21b6;
    }
    /* Accessory Layout Footer */
    .accessory-footer {
        margin-top: 25px;
        padding-top: 15px;
        border-top: 1px dashed var(--border-color);
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #b19ffb;
        flex-wrap: wrap;
        gap: 8px;
    }
    .accessory-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* 📱 Comprehensive Responsive Media Queries for Phone, Tablet & Laptop */
    @media (max-width: 992px) {
        .contact-layout-wrapper {
            max-width: 720px;
        }
    }

    @media (max-width: 768px) {
        .contact-layout-wrapper {
            flex-direction: column; /* Automatically switches side-by-side flex panels into vertical stacking on tablets & phones */
            margin: 20px auto;
            padding: 0 10px;
        }
    }

    @media (max-width: 480px) {
        .btn-group {
            flex-direction: column; /* Full width button stacking on compact phone displays */
        }
        .btn-submit, .btn-cancel {
            width: 100%;
        }
    }
</style>
<div class="contact-layout-wrapper">
    <!-- Left Panel (Now styled in Glamorous Deep Violet) -->
    <div class="left-panel">
        <div class="badge">
            ✨ GET IN TOUCH
        </div>
        <h3>Let's Bring Your Vision to Life</h3>
        <p>
            Have question or need support? Feel free to contact us anytime. 
            We're here to help you find the right opportunities.
        </p>
        <div class="info-box">
            <div class="icon">✉️</div>
            <div>
                <span>EMAIL US</span>
                <h4>zinwaim250@gmail.com</h4>
            </div>
        </div>
        <div class="info-box">
            <div class="icon">📞</div>
            <div>
                <span>CALL US</span>
                <h4>09 774 788 654</h4>
            </div>
        </div>
        <div class="info-box">
            <div class="icon">📍</div>
            <div>
                <span>VISIT US</span>
                <h4>NSPU</h4>
            </div>
        </div>
    </div>
    <!-- Right Panel (Now accented with Amethyst Purple details) -->
    <div class="right-panel">
        <h2 class="contact-title">
            📩 Contact System Administrator
        </h2>
        <p class="contact-desc">
            If you encounter any issues, technical bugs, or have inquiries regarding your internship applications, please drop a direct message below. Our admin team will review it.
        </p>
        
        <hr class="divider">
        <form action="/contact-admin" method="POST">
            <label class="form-label">Your Account Details:</label>
            <div class="account-details-box">
                <strong>Name:</strong> <%= user.name %> <br>
                <strong>Email:</strong> <%= user.email %>
            </div>
            <label class="form-label-spacing">Message / Report Details:</label>
            <textarea name="message" rows="6" placeholder="Describe your issue or feedback in detail here..." class="message-textarea" required></textarea>
            
            <div class="btn-group">
                <button type="submit" class="btn btn-submit">Send Message</button>
                <a href="/" class="btn btn-cancel">Cancel</a>
            </div>
        </form>
        <!-- Visual Accessory Details Block -->
        <div class="accessory-footer">
            <div class="accessory-item">
                <span>⚡ System Status: Operational</span>
            </div>
            <div class="accessory-item">
                <span>🔒 Secure 256-bit Connection</span>
            </div>
        </div>
    </div>
</div>
</body>
</html>
<%- include('partials/footer') %>