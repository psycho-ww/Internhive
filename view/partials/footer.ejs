<!-- footer.ejs -->
<style>
    footer {
        width: 100%;
        color: white;
        background: linear-gradient(135deg, #acb1e9, #e6c9ef, #f8dee7);
        padding: 50px 80px 20px;
        box-sizing: border-box;
    }

    .footer-container {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 40px;
    }

    .footer-left {
        width: 300px;
        max-width: 100%; /* FIX: Prevents overflow on screens narrower than 300px */
    }

    .footer-left img {
        width: 80px;
        margin-bottom: 15px;
        background: white;
        padding: 10px;
        border-radius: 10px;
    }

    .footer-left p {
        line-height: 1.5;
        font-size: 14px;
        color:black;
    }

    .footer-links h3 {
        margin-bottom: 15px;
        font-size: 18px;
        color: black;
    }

    .footer-links ul {
        list-style: none;
        font-size: 18px;
        padding: 0;
        margin: 0;
    }

    .footer-links ul li {
        margin: 10px 0;
        cursor: pointer;
        opacity: 0.9;
    }

    .footer-links ul li a {
        color: rgb(13, 8, 8);
        text-decoration: none;
    }

    .footer-links ul li:hover {
        opacity: 1;
        text-decoration: underline;
    }

    .footer-social h3 {
        margin-bottom: 15px;
        color: black;
    }

    .social-icons {
        display: flex;
        gap: 15px;
        margin-top: 10px;
    }

    .social-icons a {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 50%;
        color: rgb(33, 60, 235);
        text-decoration: none;
        transition: 0.3s;
    }

    /* Target the SVG inside the link to handle sizing and color */
    .social-icons a svg {
        width: 26px;
        height: 26px;
        fill: currentColor; /* Inherits the blue color from the 'a' tag */
    }

    .social-icons a:hover {
        transform: scale(1.1);
    }

    footer hr {
        margin: 30px 0 15px;
        border: 0;
        border-top: 0.5px solid rgba(0, 0, 0, 0.15);
    }

    .footer-bottom {
        text-align: center;
        font-size: 18px;
        font-weight: 500;
        color:black;
        opacity: 0.9;
    }

    @media(max-width: 768px){
        footer {
            padding: 40px 20px; /* FIX: Slight reduction in padding on small screens to give content more breathing room */
        }

        .footer-container {
            flex-direction: column;
            text-align: center;
            align-items: center;
            gap: 30px; /* FIX: Tighter spacing for a cleaner stacked look */
        }

        /* FIX: Ensures the container behaves responsively when centered */
        .footer-left {
            width: 100%; 
        }

        .social-icons {
            justify-content: center;
        }
    }
</style>

<footer>
    <div class="footer-container">
        <div class="footer-left">
            <p>
                Helping students and professionals discover internships, jobs,
                and career opportunities in technology.
            </p>
        </div>
        <div class="footer-links">
            <h3>Info</h3>
            <ul>
                <li><a href="/explore">Explore</a></li>
                <li><a href="/about_us">About Us</a></li>
                <li><a href="/contact">Contact Us</a></li>
                
            </ul>
        </div>
        <div class="footer-social">
            <h3>Where are we?</h3>
            <div class="social-icons">
                <!-- Facebook SVG -->
