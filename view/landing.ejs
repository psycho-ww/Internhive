<!-- Functional Scripts -->
<script>
    // --- Sidebar Mechanics & UI Toggles ---
    const openMenuBtn = document.getElementById('openMenuBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');
    const sideMenuBar = document.getElementById('sideMenuBar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    function toggleSidebar() {
        if(sideMenuBar && sidebarOverlay) {
            sideMenuBar.classList.toggle('active');
            sidebarOverlay.classList.toggle('active');
        }
    }
    if(openMenuBtn) openMenuBtn.addEventListener('click', toggleSidebar);
    if(closeMenuBtn) closeMenuBtn.addEventListener('click', toggleSidebar);
    if(sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
    // --- Swiper-Style 10-Image Seamless Infinite Slider Logic ---
    const viewframe = document.getElementById('carouselViewframe');
    const track = document.getElementById('carouselTrack');
    const originalSlides = Array.from(track.children);
    const totalOriginals = originalSlides.length;
    const dotsContainer = document.getElementById('dotsContainer');
    
    // Create Clones for Loop
    const firstClone = originalSlides[0].cloneNode(true);
    const lastClone = originalSlides[totalOriginals - 1].cloneNode(true);
    
    track.appendChild(firstClone);
    track.insertBefore(lastClone, originalSlides[0]);
    
    let carouselIndex = 1; 
    let slideInterval;
    let isTransitioning = false;
    let startX = 0;
    let isDragging = false;
    track.style.transition = 'none';
    track.style.transform = `translateX(-${carouselIndex * 100}%)`;
    // Generate Indicators
    originalSlides.forEach((_, index) => {
        const dot = document.createElement('div');
        dot.classList.add('dot');
        if (index === 0) dot.classList.add('active');
        dot.addEventListener('click', () => {
            if (isTransitioning) return;
            goToSlide(index + 1);
            restartAutoplay();
        });
        dotsContainer.appendChild(dot);
    });
    const dots = Array.from(dotsContainer.children);
    function updateDots(activeOriginalIndex) {
        dots.forEach((dot, i) => {
            if (i === activeOriginalIndex) dot.classList.add('active');
            else dot.classList.remove('active');
        });
    }
    function goToSlide(targetIndex) {
        isTransitioning = true;
        carouselIndex = targetIndex;
        track.style.transition = 'transform 0.7s cubic-bezier(0.25, 1, 0.5, 1)';
        track.style.transform = `translateX(-${carouselIndex * 100}%)`;
        let dotIndex = carouselIndex - 1;
        if (carouselIndex === 0) dotIndex = totalOriginals - 1;
        if (carouselIndex === totalOriginals + 1) dotIndex = 0;
        updateDots(dotIndex);
    }
    function nextSlide() {
        if (isTransitioning) return;
        goToSlide(carouselIndex + 1);
    }
    function prevSlide() {
        if (isTransitioning) return;
        goToSlide(carouselIndex - 1);
    }
    track.addEventListener('transitionend', () => {
        isTransitioning = false;
        if (carouselIndex === totalOriginals + 1) {
            track.style.transition = 'none';
            carouselIndex = 1;
            track.style.transform = `translateX(-${carouselIndex * 100}%)`;
        }
        if (carouselIndex === 0) {
            track.style.transition = 'none';
            carouselIndex = totalOriginals;
            track.style.transform = `translateX(-${carouselIndex * 100}%)`;
        }
    });
    // Swiping Engine
    viewframe.addEventListener('mousedown', dragStart);
    viewframe.addEventListener('touchstart', dragStart, { passive: true });
    viewframe.addEventListener('mouseup', dragEnd);
    viewframe.addEventListener('mouseleave', dragEnd);
    viewframe.addEventListener('touchend', dragEnd);
    viewframe.addEventListener('mousemove', dragMove);
    viewframe.addEventListener('touchmove', dragMove, { passive: true });
    function dragStart(e) {
        if (isTransitioning) return;
        isDragging = true;
        startX = e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
        clearInterval(slideInterval);
    }
    function dragMove(e) {
        if (!isDragging) return;
        const currentX = e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
        const diffX = currentX - startX;
        const viewframeWidth = viewframe.offsetWidth;
        const currentPercentage = (diffX / viewframeWidth) * 100;
        
        track.style.transition = 'none';
        track.style.transform = `translateX(calc(-${carouselIndex * 100}% + ${currentPercentage}%))`;
    }
    function dragEnd(e) {
        if (!isDragging) return;
        isDragging = false;
        const endX = e.type.includes('mouse') ? e.pageX : (e.changedTouches ? e.changedTouches[0].clientX : startX);
        const diffX = endX - startX;
        if (Math.abs(diffX) > 80) { 
            if (diffX > 0) prevSlide(); 
            else nextSlide(); 
        } else {
            goToSlide(carouselIndex); 
        }
        startAutoplay();
    }
    function startAutoplay() {
        slideInterval = setInterval(nextSlide, 5500);
    }
    function restartAutoplay() {
        clearInterval(slideInterval);
        startAutoplay();
    }
    startAutoplay();
     
    // Category Card Expanded text toggle
    function toggleReadMore(btn) {
        const card = btn.closest('.category-item-card');
        card.classList.toggle('expanded');
        if (card.classList.contains('expanded')) {
            btn.textContent = "Read Less";
        } else {
            btn.textContent = "Read More";
        }
    }
    // Horizontal Slider Logic
    const slideTrack = document.getElementById('slideTrack');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    let sliderIndex = 0;
    function getVisibleCardsCount() {
        if (window.innerWidth <= 768) return 1;
        if (window.innerWidth <= 1024) return 2;
        return 3;
    }
    function updateSliderPosition() {
        const card = document.querySelector('.category-item-card');
        if (!card) return;
        const cardWidth = card.getBoundingClientRect().width;
        const gap = 24; // 1.5rem gap in pixels
        slideTrack.style.transform = `translateX(-${sliderIndex * (cardWidth + gap)}px)`;
    }
    nextBtn.addEventListener('click', () => {
        const totalCards = document.querySelectorAll('.category-item-card').length;
        const visibleCards = getVisibleCardsCount();
        if (sliderIndex < totalCards - visibleCards) {
            sliderIndex++;
            updateSliderPosition();
        }
    });
    prevBtn.addEventListener('click', () => {
        if (sliderIndex > 0) {
            sliderIndex--;
            updateSliderPosition();
        }
    });
    window.addEventListener('resize', () => {
        sliderIndex = 0;
        updateSliderPosition();
    });
    // Scroll Reveal Animation (Intersection Observer Pop-up Effect)
    document.addEventListener("DOMContentLoaded", function () {
        const sections = document.querySelectorAll(".reveal-section");
        
        const revealOptions = {
            threshold: 0.12,
            rootMargin: "0px 0px -50px 0px"
        };
        const revealObserver = new IntersectionObserver(function (entries, observer) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("active");
                } else {
                    entry.target.classList.remove("active");
                }
            });
        }, revealOptions);
        sections.forEach(section => {
            revealObserver.observe(section);
        });
    });
</script>
