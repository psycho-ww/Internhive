<%- include('partials/header') %>
<style>
 :root {
    --sparkle-gradient: linear-gradient(135deg, #00c6ff, #0072ff, #9333ea, #ff007f);
    --bg-glass: rgba(255, 255, 255, 0.85);
    --card-shadow: 0 8px 32px 0 rgba(148, 163, 184, 0.08);
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
body {
    margin: 0;
    padding: 0;
    overflow-x: hidden; /* Safeguards against horizontal viewport overflow on mobile screens */
}
.gemini-bg {
    width: 100vw;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    background: linear-gradient(-45deg, #f1f5f9, #e2e8f0, #fce7f3, #eff6ff);
    background-size: 400% 400%;
    animation: geminiGradient 15s ease infinite;
}
@keyframes geminiGradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}
    /* Common Layout Styles - Fluid Sizing */
    .profile-container {
        max-width: 1000px;
        width: 100%;
        margin: clamp(15px, 4vw, 30px) auto;
        padding: 0 clamp(10px, 3vw, 15px);
        font-family: 'Segoe UI', sans-serif;
        color: #eceff4;
        box-sizing: border-box;
    }
    
    .card-wrapper {
        background: #b8f1f8;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        margin-bottom: 30px;
        position: relative;
    }
    /* Cover Photo Section - Responsive Height Scaling */
    .cover-photo-section {
        height: clamp(220px, 40vw, 450px);
        background-size: cover;
        background-position: center;
        position: relative;
        border-radius: 0% 0% 16px 16px;
    }
    
    .cover-upload-form {
        position: absolute;
        bottom: 15px;
        right: 15px;
    }
    
    .cover-upload-label {
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }
    /* Avatar & Profile Header */
    .profile-header {
        padding: clamp(15px, 3vw, 20px) clamp(15px, 3vw, 30px);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-top: -65px;
        position: relative;
        z-index: 5;
        border-bottom: 1px solid #f1f5f9;
    }
    
    .avatar-container {
        width: clamp(100px, 15vw, 130px);
        height: clamp(100px, 15vw, 130px);
        background: #f1f5f9;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .avatar-emoji {
        font-size: 50px;
    }
    
    .profile-name {
        margin: 10px 0 5px 0;
        font-size: clamp(1.4rem, 3vw, 28px);
        font-weight: 700;
        color: #0f172a;
        word-break: break-word;
    }
    
    .profile-location {
        margin: 0 0 15px 0;
        color: #64748b;
        font-size: 15px;
        word-break: break-word;
    }
    
    .action-buttons-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
    }
    
    .btn-edit-profile {
        background: #c150e7;
        color: black;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        box-sizing: border-box;
    }
    .btn-edit-profile:hover {
        background: #8c8fea;
        color:#000000;
    }
    
    .btn-post-project {
        background: #b1fd47;
        color: black;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        box-sizing: border-box;
    }
    .btn-post-project:hover {
        background: #74edc5;
        color:#000000;
    }
    .btn-post-vacancy {
        background: #b1fd47;
        color: black;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        box-sizing: border-box;
    }
   .btn-post-vacancy:hover {
        background: #74edc5;
        color:#000000;
    }
    /* Info Details Section */
    .info-section {
        padding: clamp(20px, 4vw, 30px);
        background: #b8f1f8;
        box-sizing: border-box;
    }
    
    .info-title {
        margin-top: 0;
        color: #0f172a;
        font-size: 18px;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 8px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .info-icon {
  /* Sets the icon to a standard small profile asset size */
  width: 40px;
  height: 40px;
  
  /* Prevents any stretching or squishing of the vector lines */
  object-fit: contain;
  
  /* Makes sure it aligns perfectly inline next to any text */
  vertical-align: middle;
  flex-shrink: 0;
}
    .info-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 15px;
        color: #000000;
        font-weight: 600;
        word-break: break-word;
    }
    
    .info-list > div {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .info-label {
        color: #475569;
        font-weight: normal;
        display: inline-block;
        width: 150px;
        flex-shrink: 0;
    }
    
    .website-link {
        color: #1e40af;
        text-decoration: underline;
        word-break: break-all;
    }
    /* Timeline Feed Section */
    .timeline-section {
        background: white;
        padding: clamp(15px, 3vw, 25px);
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        border: 1px solid #e2e8f0;
        box-sizing: border-box;
        margin-bottom: 20px;
    }
    
    .timeline-title {
        margin-top: 0;
        color: #1e293b;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-size: clamp(1.1rem, 2vw, 1.3rem);
    }
    
    .no-posts {
        color: #64748b;
        font-style: italic;
        text-align: center;
        padding: 30px 0;
        background: white;
        border-radius: 12px;
    }
    
    .post-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: clamp(15px, 3vw, 20px);
        margin-bottom: 20px;
        background: #ffffff;
        box-sizing: border-box;
    }
    
    .post-header {
        margin-bottom: 12px;
    }
    
    .post-title {
        margin: 0 0 4px 0;
        color: #1e3a8a;
        font-size: clamp(1.1rem, 2vw, 18px);
        font-weight: 700;
        word-break: break-word;
    }
    
    .post-author {
        color: #94a3b8;
    }
    
    .post-content {
        color: #222222;
        font-size: 15px;
        line-height: 1.6;
        white-space: pre-wrap;
        margin-bottom: 15px;
        word-break: break-word;
    }
    
    .post-image-container {
        margin-bottom: 15px;
        border-radius: 8px;
        overflow: hidden;
        max-height: 350px;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        display: flex;
        justify-content: center;
    }
    
    .post-image {
        width: 100%;
        height: auto;
        object-fit: contain;
        max-height: 350px;
    }
    
    .post-actions {
        display: flex;
        gap: 10px;
        border-top: 1px solid #f1f5f9;
        padding-top: 15px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }
    
    .btn-edit-action {
        background: #d2f85f;
        color: black;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        box-sizing: border-box;
        text-align: center;
    }
    .btn-edit-action:hover {
        background: #a3e635;
        color: #000000;
    }
    .btn-delete-action {
        background: #e23d3d;
        color: black;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        box-sizing: border-box;
    }
    .btn-delete-action :hover {
        background: #c65f5f;
        color: #000000;
    }
    /* Modal Styles */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 15px;
        box-sizing: border-box;
    }
    
    .modal-content-edit {
        background: white;
        padding: clamp(20px, 4vw, 30px);
        border-radius: 12px;
        width: 100%;
        max-width: 500px;
        max-height: 85vh;
        overflow-y: auto;
        box-sizing: border-box;
    }
    
    .modal-content-create {
        background: white;
        padding: clamp(20px, 4vw, 30px);
        border-radius: 12px;
        width: 100%;
        max-width: 550px;
        max-height: 85vh;
        overflow-y: auto;
        box-sizing: border-box;
    }
    
    .modal-header-text {
        margin-top: 0;
        margin-bottom: 20px;
        color: #0f172a;
    }
    
    .modal-form-group {
        margin-bottom: 12px;
    }
    
    .modal-form-group-spaced {
        margin-bottom: 15px;
    }
    
    .modal-form-group-large {
        margin-bottom: 20px;
    }
    
    .modal-label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
        color: #1e293b;
        font-size: 14px;
    }
    
    .modal-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
    }
    
    .modal-textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
        resize: vertical;
    }
    
    .modal-footer-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    
    .btn-modal-cancel {
        padding: 8px 15px;
        background: #e2e8f0;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }
    
    .btn-modal-save {
        padding: 8px 15px;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }
    
    .btn-modal-publish-project {
        padding: 10px 15px;
        background: #22c55e;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }
    
    .btn-modal-publish-job {
        padding: 10px 15px;
        background: #10b981;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    /* 📱 Responsive Media Query Enhancements */
    @media (max-width: 576px) {
        .info-label {
            width: 100%;
        }
        .action-buttons-group {
            flex-direction: column;
            width: 100%;
        }
        .btn-edit-profile, .btn-post-project, .btn-post-vacancy {
            width: 100%;
        }
        .post-actions {
            flex-direction: column;
        }
        .btn-edit-action, .btn-delete-action {
            width: 100%;
            text-align: center;
        }
    }
</style>
<div class="gemini-bg"></div>
<div class="profile-container">
    
    <div class="card-wrapper">
        
        <div class="cover-photo-section" style="background-image: <%= user.cover_pic ? 'url(/uploads/' + user.cover_pic + ')' : 'linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)' %>;">
            <form action="/profile/update-cover" method="POST" enctype="multipart/form-data" class="cover-upload-form">
                <label class="cover-upload-label">
                    📷 Change Cover Photo
                    <input type="file" name="cover_pic" accept="image/*" onchange="this.form.submit()" style="display: none;">
                </label>
            </form>
        </div>
        <div class="profile-header">
            
            <div class="avatar-container">
                <% if (user.profile_pic) { %>
                    <img src="/uploads/<%= user.profile_pic %>" class="avatar-img">
                <% } else { %>
                    <span class="avatar-emoji"><%= user.role === 1 ? '🎓' : '💼' %></span>
                <% } %>
            </div>
            <h1 class="profile-name"><%= user.name %></h1>
            <p class="profile-location">📍 <%= user.location || 'No location set' %></p>
            <div class="action-buttons-group">
                <button onclick="openModal('editProfileModal')" class="btn-edit-profile">
                    ✏️ Edit Profile
                </button>
                <% if (user.role === 1) { %>
                    <button onclick="openModal('createPostModal')" class="btn-post-project">
                        ➕ Post Project
                    </button>
                <% } else if (user.role === 2) { %>
                    <button onclick="openModal('createJobModal')" class="btn-post-vacancy">
                        💼Post Internship
                    </button>
                <% } %>
            </div>
        </div>
        <div class="info-section">
            <h3 class="info-title"><image src="/images/Gemini_Generated_Image_k0ip0yk0ip0yk0ip.png" alt="Info Icon" class="info-icon"></image>Profile Information</h3>
            <div class="info-list">
                <div><span class="info-label">Email Address:</span> <%= user.email %></div>
                <div><span class="info-label">Location:</span> <%= user.location || 'Not Specified' %></div>
                
                <% if (user.role === 1) { %>
                    <div class="open-info"><span class="info-label">University:</span> <%= user.uni || 'Not Specified' %></div>
                    <div><span class="info-label">Major Subject:</span> <%= user.major || 'Not Specified' %></div>
                    <div><span class="info-label">Academic Year:</span> <%= user.year || 'Not Specified' %></div>
                    <div>
    <span class="info-label">Curriculum Vitae (CV):</span>
    <% if (user.cv_file) { %>
        <a href="/uploads/<%= user.cv_file %>" target="_blank" class="website-link" style="color: #2563eb; font-weight: bold;">📄 View My Uploaded CV</a>
    <% } else { %>
        <span style="color: #dc2626; font-style: italic;">No CV Uploaded Yet</span>
    <% } %>
</div>
                <% } else if (user.role === 2) { %>
                    <div><span class="info-label">Industry / Sector:</span> <%= user.industry || 'Not Specified' %></div>
                    <div><span class="info-label">Company Size:</span> <%= user.company_size || 'Not Specified' %></div>
                    <div><span class="info-label">Type of Ownership:</span> <%= user.ownership_type || 'Not Specified' %></div>
                    <div>
                        <span class="info-label">Website URL:</span> 
                        <% if (user.website_url) { %>
                            <a href="<%= user.website_url %>" target="_blank" class="website-link"><%= user.website_url %></a>
                        <% } else { %>
                            Not Specified
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
            
            
    <% if (typeof user !== 'undefined' && user.role !== 3) { %>
    <div class="timeline-section">
        <h3 class="timeline-title">
            📝 Timeline Feed Updates (<%= myPosts ? myPosts.length : 0 %>)
        </h3>
    </div>
<% } %>
        <% if (!myPosts || myPosts.length === 0) { %>
            <p class="no-posts">No updates on your timeline yet.</p>
        <% } else { %>
            <% myPosts.forEach(post => { %>
                <div class="post-card">
                    <div class="post-header">
                        <h4 class="post-title"><%= post.title %></h4>
                        <small class="post-author">Published by You</small>
                    </div>
                    <p class="post-content"><%= user.role === 1 ? post.content : post.description %></p>
                    <% if (post.image_url) { %>
                        <div class="post-image-container">
                            <img src="/uploads/<%= post.image_url %>" class="post-image">
                        </div>
                    <% } %>
                    <div class="post-actions">
                        <% if (user.role === 1) { %>
                            <a href="/post/edit/<%= post.id %>" class="btn-edit-action">✏️ Edit Post</a>
                            <form action="/post/delete/<%= post.id %>" method="POST" onsubmit="return confirm('Delete permanently?');" style="display: inline;">
                                <button type="submit" class="btn-delete-action">🗑️ Delete</button>
                            </form>
                        <% } else { %>
                            <a href="/company/job/edit/<%= post.id %>" class="btn-edit-action">✏️ Edit</a>
                            <form action="/company/job/delete/<%= post.id %>" method="POST" onsubmit="return confirm('Delete permanently?');" style="display: inline;">
                                <button type="submit" class="btn-delete-action">🗑️ Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
<div id="editProfileModal" class="modal-overlay">
    <div class="modal-content-edit">
        <h3 class="modal-header-text">✏️ Edit Profile Info & Pictures</h3>
        <form action="/profile/update" method="POST" enctype="multipart/form-data">
            
            <div class="modal-form-group-spaced">
                <label class="modal-label">Change Profile Picture</label>
                <input type="file" name="profile_pic" accept="image/*">
            </div>
            <div class="modal-form-group-spaced">
                <label class="modal-label">Change Cover Photo</label>
                <input type="file" name="cover_pic" accept="image/*">
            </div>
            <!-- Student ဖြစ်မှသာ CV Upload နေရာ ပေါ်လာစေရန် ဤနေရာတွင် စစ်ထားပါသည် -->
            <% if (user.role === 1) { %>
                <div class="modal-form-group-spaced">
                    <label class="modal-label" style="color: #dc2626;">📄 Upload / Update CV (PDF Only)</label>
                    <input type="file" name="cv_file" accept=".pdf">
                    <% if (user.cv_file) { %>
                        <p style="font-size: 12px; color: #475569; margin-top: 4px;">Current File: <%= user.cv_file %></p>
                    <% } %>
                </div>
            <% } %>
            
            <div class="modal-form-group">
                <label class="modal-label">Name / Entity Name</label>
                <input type="text" name="name" value="<%= user.name %>" required class="modal-input">
            </div>
            <div class="modal-form-group">
                <label class="modal-label">Email Address</label>
                <input type="email" name="email" value="<%= user.email %>" required class="modal-input">
            </div>
            <div class="modal-form-group">
                <label class="modal-label">Location</label>
                <input type="text" name="location" value="<%= user.location || '' %>" class="modal-input">
            </div>
            <% if (user.role === 1) { %>
                <div class="modal-form-group">
                    <label class="modal-label">University</label>
                    <input type="text" name="uni" value="<%= user.uni || '' %>" class="modal-input">
                </div>
                <div class="modal-form-group">
                    <label class="modal-label">Major</label>
                    <input type="text" name="major" value="<%= user.major || '' %>" class="modal-input">
                </div>
                <div class="modal-form-group">
                    <label class="modal-label">Academic Year</label>
                    <input type="text" name="year" value="<%= user.year || '' %>" class="modal-input">
                </div>
            <% } else if (user.role === 2) { %>
                <div class="modal-form-group">
                    <label class="modal-label">Industry</label>
                    <input type="text" name="industry" value="<%= user.industry || '' %>" class="modal-input">
                </div>
                <div class="modal-form-group">
                    <label class="modal-label">Company Size</label>
                    <input type="text" name="company_size" value="<%= user.company_size || '' %>" class="modal-input">
                </div>
                <div class="modal-form-group">
                    <label class="modal-label">Ownership Type</label>
                    <input type="text" name="ownership_type" value="<%= user.ownership_type || '' %>" class="modal-input">
                </div>
                <div class="modal-form-group">
                    <label class="modal-label">Website URL</label>
                    <input type="url" name="website_url" value="<%= user.website_url || '' %>" class="modal-input">
                </div>
            <% } %>
            <div class="modal-footer-actions">
                <button type="button" onclick="closeModal('editProfileModal')" class="btn-modal-cancel">Cancel</button>
                <button type="submit" class="btn-modal-save">Save Changes</button>
            </div>
        </form>
    </div>
</div>
<div id="createPostModal" class="modal-overlay">
    <div class="modal-content-create">
        <h3>🚀 Publish New Project</h3>
        <form action="/post/create" method="POST" enctype="multipart/form-data">
            <div class="modal-form-group-spaced">
                <label class="modal-label">Title</label>
                <input type="text" name="title" required class="modal-textarea">
            </div>
            <div class="modal-form-group-spaced">
                <label class="modal-label">Details</label>
                <textarea name="content" rows="5" required class="modal-textarea"></textarea>
            </div>
            <div class="modal-form-group-large">
                <label class="modal-label">Image</label>
                <input type="file" name="post_img" accept="image/*">
            </div>
            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" onclick="closeModal('createPostModal')" class="btn-modal-cancel">Cancel</button>
                <button type="submit" class="btn-modal-publish-project">Publish</button>
            </div>
        </form>
    </div>
</div>
<div id="createJobModal" class="modal-overlay">
    <div class="modal-content-create">
        <h3>💼 Post Corporate Internship</h3>
        <form action="/company/job/create" method="POST" enctype="multipart/form-data">
            <div class="modal-form-group-spaced">
                <label class="modal-label">job Title</label>
                <input type="text" name="title" required class="modal-textarea">
            </div>
            <div class="modal-form-group-spaced">
                <label class="modal-label">Description</label>
                <textarea name="description" rows="5" required class="modal-textarea"></textarea>
            </div>
            <div class="modal-form-group-large">
                <label class="modal-label">Attach Image (Optional)</label>
                <input type="file" name="job_img" accept="image/*">
            </div>
            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" onclick="closeModal('createJobModal')" class="btn-modal-cancel">Cancel</button>
                <button type="submit" class="btn-modal-publish-job">Post Live</button>
            </div>
        </form>
    </div>
</div>
<script>
    function openModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    window.onclick = function(e) { if(e.target.id.endsWith('Modal')) e.target.style.display = 'none'; }
</script>
</body>
</html>