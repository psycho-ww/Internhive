<style>
    /* Modern Purple Theme Variables */
    :root {
        --primary-glow: linear-gradient(135deg, #a24ef1 0%, #4979f2 50%, #fe47e0 100%);
        --bg-surface: #ffffff;
        --text-main: #1e1b4b;
        --text-muted: #6b7280;
        --input-border: #e2e8f0;
        --input-focus: #a855f7;
    }
    :root {
        --sparkle-gradient: linear-gradient(135deg, #00c6ff, #0072ff, #9333ea, #ff007f);
        --bg-glass: rgba(255, 255, 255, 0.85);
        --card-shadow: 0 8px 32px 0 rgba(148, 163, 184, 0.08);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body {
        margin: 0;
        padding: 0;
        overflow-x: hidden; /* Prevents horizontal overflow on small phone screens */
    }
    .gemini-bg {
        width: 100vw;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
        background: linear-gradient(-45deg, #f1f5f9, #e2e8f0, #fce7f3, #eff6ff);
        background-size: 400% 400%;
        animation: geminiGradient 15s ease infinite;
    }
    @keyframes geminiGradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    /* Registration Card Container - Responsive Fluid Sizing */
    .register-container {
        max-width: 500px;
        width: 100%;
        margin: clamp(20px, 5vw, 40px) auto;
        padding: clamp(20px, 5vw, 40px) clamp(15px, 4vw, 30px);
        background: var(--bg-surface);
        border-radius: 24px; /* Sleeker modern radius */
        box-shadow: 0 20px 40px rgba(99, 102, 241, 0.08), 0 1px 3px rgba(0, 0, 0, 0.02);
        font-family: sans-serif;
        position: relative;
        border: 1px solid rgba(168, 85, 247, 0.1);
        box-sizing: border-box;
    }
    /* Soft glamorous background glow behind the card */
    .register-container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 25px;
        right: 25px;
        bottom: 0;
        background: var(--primary-glow);
        background-size: 200% auto;
        filter: blur(40px);
        opacity: 0.12;
        z-index: -1;
    }
    /* Form Title */
    .register-title {
        text-align: center;
        font-size: clamp(1.6rem, 4vw, 32px);
        font-weight: 800;
        background: var(--primary-glow);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmerEffect 4s linear infinite;
        margin-bottom: 30px;
        letter-spacing: -0.5px;
        word-break: break-word;
    }
    @keyframes shimmerEffect {
        0% { background-position: 0% center; }
        100% { background-position: 200% center; }
    }
     
    /* Form Group Wrapper */
    .form-group {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
    }
    /* Form Labels */
    .form-group label {
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-main);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        word-break: break-word;
    }
    /* Standard Inputs, Select, and Textareas */
    .form-control {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid var(--input-border);
        border-radius: 12px;
        font-size: 15px;
        outline: none;
        background-color: #f8fafc;
        color: var(--text-main);
        box-sizing: border-box;
        transition: all 0.25s ease;
    }
    .form-control:focus {
        border-color: var(--input-focus);
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.15);
    }
    /* Select Dropdown Specific Override */
    select.form-control {
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        background-repeat: no-repeat;
        background-position: right 16px center;
        background-size: 16px;
        appearance: none;
        padding-right: 40px;
        background-color: #f8fafc;
    }
    
    select.form-control:focus {
        background-color: #fff;
    }
    /* Dynamic Conditional Sections */
    .conditional-fields {
        display: block;
    }
    .hidden-fields {
        display: none;
    }
    /* Submit Button */
    .btn-submit {
        width: 100%;
        background: var(--primary-glow);
        background-size: 200% auto;
        color: white;
        padding: 16px;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 15px;
        transition: all 0.25s ease;
        box-shadow: 0 4px 12px rgba(168, 85, 247, 0.25);
        box-sizing: border-box;
    }
    .btn-submit:hover {
        color: #14bff4;
        background-position: right center;
        opacity: 0.95;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(168, 85, 247, 0.35);
    }
    
    .btn-submit:active {
        transform: translateY(1px);
    }

    /* 📱 Responsive Adjustments for Small Mobile Displays */
    @media (max-width: 480px) {
        .register-container {
            border-radius: 16px;
            margin: 10px auto;
            padding: 20px 15px;
        }
    }
</style>
<div class="gemini-bg"></div>
<div class="register-container">
    
    <h2 class="register-title">Account Registration</h2>
    
    <form action="/register" method="POST">
        <!-- Full Name -->
        <div class="form-group">
            <label>Full Name / Corporate Entity Name</label>
            <input type="text" name="name" required class="form-control">
        </div>
        
        <!-- Email Address -->
        <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" required class="form-control">
        </div>
        
        <!-- Password -->
        <div class="form-group">
            <label>Account Password</label>
            <input type="password" name="password" required class="form-control">
        </div>
        
        <!-- Role Selection -->
        <div class="form-group">
            <label>Select Profile Role</label>
            <select name="role" id="roleSelect" onchange="toggleRoleFields()" class="form-control">
                <option value="1">🎓 Student</option>
                <option value="2">💼 Company </option>
            </select>
        </div>
        <!-- Location -->
        <div class="form-group">
            <label>Location (City, Country)</label>
            <input type="text" name="location" placeholder="e.g. Yangon, Myanmar" required class="form-control">
        </div>
        <!-- Student Specific Fields -->
        <div id="studentFields" class="conditional-fields">
            <div class="form-group">
                <label>University Name</label>
                <input type="text" name="uni" class="form-control">
            </div>
            <div class="form-group">
                <label>Major Subject</label>
                <input type="text" name="major" class="form-control">
            </div>
            <div class="form-group">
                <label>Academic Year</label>
                <input type="text" name="year" placeholder="e.g. 2025-2026" class="form-control">
            </div>
        </div>
        <!-- Corporate Specific Fields -->
        <div id="companyFields" class="hidden-fields">
            <div class="form-group">
                <label>Industry / Sector</label>
                <input type="text" name="industry" placeholder="e.g. Banking / Financial Services" class="form-control">
            </div>
            <div class="form-group">
                <label>Company Size</label>
                <input type="text" name="company_size" placeholder="e.g. 10,000+ employees" class="form-control">
            </div>
            <div class="form-group">
                <label>Type of Ownership</label>
                <input type="text" name="ownership_type" placeholder="e.g. Private Company" class="form-control">
            </div>
            <div class="form-group">
                <label>Official Corporate Website URL</label>
                <input type="url" name="website_url" placeholder="https://www.kbzbank.com" class="form-control">
            </div>
        </div>
        <!-- Submit Button -->
        <button type="submit" class="btn-submit">Create Account</button>
    </form>
</div>
<script>
    function toggleRoleFields() {
        const role = document.getElementById('roleSelect').value;
        const studentFields = document.getElementById('studentFields');
        const companyFields = document.getElementById('companyFields');
        if (role === '1') {
            studentFields.style.display = 'block';
            companyFields.style.display = 'none';
        } else {
            studentFields.style.display = 'none';
            companyFields.style.display = 'block';
        }
    }
</script>
</body>
</html>